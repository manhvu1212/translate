<Window x:Class="AITranslator.FloatingPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AITranslator"
        mc:Ignorable="d"
        Title="Translation" 
        Icon="app_icon.ico"
        MinWidth="380"
        MaxWidth="570"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">
    
    <Window.Resources>
        <!-- Modern Rounded Button Style with Hover and Press States -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#252535"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold, Inter"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Language Pills -->
        <Style x:Key="LangPill" TargetType="Button">
            <Setter Property="Background" Value="#1E1E2C"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="#2C2C3E"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A3E"/>
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ScrollBar Thumb Style -->
        <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="Chrome"
                                CornerRadius="3"
                                Background="#334155"
                                Width="6"
                                Margin="2,0,2,0" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#475569" />
                                <Setter TargetName="Chrome" Property="Width" Value="8" />
                                <Setter TargetName="Chrome" Property="Margin" Value="1,0,1,0" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ScrollBar Style -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="10"/>
                    <Setter Property="Height" Value="Auto"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                                    <Track x:Name="PART_Track"
                                           IsDirectionReversed="true"
                                           IsEnabled="{TemplateBinding IsEnabled}">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="false" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="false" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollBarThumb}" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid x:Name="Bg" Background="Transparent" SnapsToDevicePixels="true">
                                    <Track x:Name="PART_Track"
                                           IsEnabled="{TemplateBinding IsEnabled}">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="false" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="false" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border x:Name="Chrome"
                                                                CornerRadius="3"
                                                                Background="#334155"
                                                                Height="6"
                                                                Margin="0,2,0,2" />
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background" Value="#475569" />
                                                                <Setter TargetName="Chrome" Property="Height" Value="8" />
                                                                <Setter TargetName="Chrome" Property="Margin" Value="0,1,0,1" />
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="Chrome" Property="Background" Value="#3B82F6" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Outer Border with Deep Soft Shadow and Acrylic Dark Background -->
        <Border Margin="16" CornerRadius="16" BorderThickness="1" BorderBrush="#2A2A3C" Background="#14141E">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="#000000" Direction="270"/>
            </Border.Effect>
            
            <Grid Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 0: Header / Brand Logo -->
                    <RowDefinition Height="Auto"/> <!-- Row 1: Original Text -->
                    <RowDefinition x:Name="RowTranslateSelection" Height="Auto"/> <!-- Row 2: Translate Selection Pills -->
                    <RowDefinition x:Name="RowTranslated" Height="Auto"/> <!-- Row 3: Translated Text Area -->
                    <RowDefinition x:Name="RowRewriteSelection" Height="Auto"/> <!-- Row 4: Rewrite Selection Pills -->
                    <RowDefinition x:Name="RowRewritten" Height="Auto"/> <!-- Row 5: Rewritten Text Area -->
                    <RowDefinition x:Name="RowRewriteTranslateSelection" Height="Auto"/> <!-- Row 6: Rewrite Translate Selection Pills -->
                    <RowDefinition x:Name="RowRewriteTranslated" Height="Auto"/> <!-- Row 7: Rewrite Translated Text Area -->
                    <RowDefinition Height="Auto"/> <!-- Row 8: Footer / Actions -->
                </Grid.RowDefinitions>
 
                <!-- Header / Brand Logo (drag handle to move the window) -->
                <Grid Grid.Row="0" Margin="0,2,0,16" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="Header_MouseLeftButtonDown" ToolTip="Kéo để di chuyển cửa sổ">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- App Logo and Brand Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="4" Background="#1B1B26" Padding="2" Width="18" Height="18" Margin="0,0,10,0" BorderThickness="1" BorderBrush="#242434">
                            <Image Source="app_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock Text="AI TRANSLATOR" Foreground="#3B82F6" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI Semibold" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Decorative separator line -->
                    <Border Grid.Column="1" Height="1" Background="#242434" Margin="14,0,14,0" VerticalAlignment="Center"/>

                    <!-- Mode Indicator -->
                    <TextBlock x:Name="LblQuickTranslate" Grid.Column="2" Text="⚡ Quick Translate" Foreground="#475569" FontSize="8.5" FontWeight="SemiBold" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                </Grid>

                <!-- Original Text Area (câu 1) -->
                <Border Grid.Row="1" CornerRadius="10" Background="#1B1B26" Padding="12" Margin="0,0,0,10" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="#242434"/>
                            <Style.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtOriginal" 
                                 Text="Original text goes here..." 
                                 TextWrapping="Wrap" 
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 MaxHeight="80"
                                 Background="Transparent"
                                 Foreground="#CBD5E1"
                                 BorderThickness="0"
                                 FontSize="11.5" 
                                 CaretBrush="#3B82F6"
                                 Margin="0,0,12,0"
                                 FontFamily="Segoe UI"
                                 FocusVisualStyle="{x:Null}"
                                 PreviewKeyDown="TxtOriginal_PreviewKeyDown"/>
                        <Button x:Name="BtnCopyOriginal" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Width="26" Height="24" Style="{StaticResource ModernButton}" Content="📋" Click="BtnCopyOriginal_Click" Padding="0" Margin="4,0,0,0" ToolTip="Sao chép câu gốc"/>
                    </Grid>
                </Border>

                <!-- Translate Selection Pills (btn dịch) -->
                <Grid x:Name="GridTranslateSelection" Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="LblTranslateTo" Text="DỊCH SANG:" Foreground="#475569" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Segoe UI"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnLangVi" Style="{StaticResource LangPill}" Content="VI" Click="BtnLangPill_Click" Tag="Vietnamese"/>
                        <Button x:Name="BtnLangEn" Style="{StaticResource LangPill}" Content="EN" Click="BtnLangPill_Click" Tag="English"/>
                        <Button x:Name="BtnLangJa" Style="{StaticResource LangPill}" Content="JA" Click="BtnLangPill_Click" Tag="Japanese"/>
                        <Button x:Name="BtnLangKo" Style="{StaticResource LangPill}" Content="KO" Click="BtnLangPill_Click" Tag="Korean"/>
                        <Button x:Name="BtnLangZh" Style="{StaticResource LangPill}" Content="ZH" Click="BtnLangPill_Click" Tag="Chinese"/>
                    </StackPanel>
                </Grid>

                <!-- Translated Text Area (câu 2) -->
                <Border x:Name="BorderTranslated" Grid.Row="3" CornerRadius="10" Background="#1B1B26" Padding="12" Margin="0,0,0,12" BorderThickness="1" BorderBrush="#242434">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtTranslated" 
                                       Text="Đang dịch bằng AI..." 
                                       TextWrapping="Wrap" 
                                       Foreground="#F8FAFC" 
                                       FontSize="13.5" 
                                       LineHeight="20"
                                       Margin="0,0,12,0"
                                       FontFamily="Segoe UI Semibold"/>
                        </ScrollViewer>
                        <Button x:Name="BtnCopyTranslated" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Width="26" Height="24" Style="{StaticResource ModernButton}" Content="📋" Click="BtnCopyTranslated_Click" Padding="0" Margin="4,0,0,0" ToolTip="Sao chép câu dịch"/>
                    </Grid>
                </Border>
 
                <!-- Rewrite Selection Pills (btn rewrite) -->
                <Grid x:Name="GridRewriteSelection" Grid.Row="4" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="LblRewrite" Text="VIẾT LẠI:" Foreground="#475569" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Segoe UI"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnToneFluent" Style="{StaticResource LangPill}" Content="Trôi chảy" Click="BtnTonePill_Click" Tag="Fluent"/>
                        <Button x:Name="BtnToneFormal" Style="{StaticResource LangPill}" Content="Trang trọng" Click="BtnTonePill_Click" Tag="Formal"/>
                        <Button x:Name="BtnToneCasual" Style="{StaticResource LangPill}" Content="Thân mật" Click="BtnTonePill_Click" Tag="Casual"/>
                        <Button x:Name="BtnToneConcise" Style="{StaticResource LangPill}" Content="Ngắn gọn" Click="BtnTonePill_Click" Tag="Concise"/>
                    </StackPanel>
                </Grid>

                <!-- Rewritten Text Area (câu 3) -->
                <Border x:Name="BorderRewritten" Grid.Row="5" CornerRadius="10" Background="#1B1B26" Padding="12" Margin="0,0,0,12" BorderThickness="1" BorderBrush="#242434" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblRewrittenHeader" Grid.Row="0" Grid.ColumnSpan="2" Text="BẢN VIẾT LẠI (TRÔI CHẢY):" Foreground="#475569" FontSize="9" FontWeight="Bold" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                        <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtRewritten" 
                                       Text="Đang viết lại câu dịch bằng AI..." 
                                       TextWrapping="Wrap" 
                                       Foreground="#F8FAFC" 
                                       FontSize="13.5" 
                                       LineHeight="20"
                                       Margin="0,0,12,0"
                                       FontFamily="Segoe UI Semibold"/>
                        </ScrollViewer>
                        <Button x:Name="BtnCopyRewritten" Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Width="26" Height="24" Style="{StaticResource ModernButton}" Content="📋" Click="BtnCopyRewritten_Click" Padding="0" Margin="4,0,0,0" ToolTip="Sao chép câu viết lại"/>
                    </Grid>
                </Border>

                <!-- Rewrite Translate Selection Pills (cho phép dịch câu viết lại sang ngôn ngữ khác) -->
                <Grid x:Name="GridRewriteTranslateSelection" Grid.Row="6" Margin="0,0,0,10" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock x:Name="LblRewriteTranslateTo" Text="DỊCH SANG:" Foreground="#475569" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Segoe UI"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnRewriteLangVi" Style="{StaticResource LangPill}" Content="VI" Click="BtnRewriteLangPill_Click" Tag="Vietnamese"/>
                        <Button x:Name="BtnRewriteLangEn" Style="{StaticResource LangPill}" Content="EN" Click="BtnRewriteLangPill_Click" Tag="English"/>
                        <Button x:Name="BtnRewriteLangJa" Style="{StaticResource LangPill}" Content="JA" Click="BtnRewriteLangPill_Click" Tag="Japanese"/>
                        <Button x:Name="BtnRewriteLangKo" Style="{StaticResource LangPill}" Content="KO" Click="BtnRewriteLangPill_Click" Tag="Korean"/>
                        <Button x:Name="BtnRewriteLangZh" Style="{StaticResource LangPill}" Content="ZH" Click="BtnRewriteLangPill_Click" Tag="Chinese"/>
                    </StackPanel>
                </Grid>

                <!-- Rewrite Translated Text Area (câu dịch của câu viết lại) -->
                <Border x:Name="BorderRewriteTranslated" Grid.Row="7" CornerRadius="10" Background="#1B1B26" Padding="12" Margin="0,0,0,12" BorderThickness="1" BorderBrush="#242434" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblRewriteTranslatedHeader" Grid.Row="0" Grid.ColumnSpan="2" Text="BẢN DỊCH CỦA CÂU VIẾT LẠI (TIẾNG ANH):" Foreground="#475569" FontSize="9" FontWeight="Bold" Margin="0,0,0,8" FontFamily="Segoe UI"/>
                        <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtRewriteTranslated" 
                                       Text="Đang dịch..." 
                                       TextWrapping="Wrap" 
                                       Foreground="#F8FAFC" 
                                       FontSize="13.5" 
                                       LineHeight="20"
                                       Margin="0,0,12,0"
                                       FontFamily="Segoe UI Semibold"/>
                        </ScrollViewer>
                        <Button x:Name="BtnCopyRewriteTranslated" Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right" Width="26" Height="24" Style="{StaticResource ModernButton}" Content="📋" Click="BtnCopyRewriteTranslated_Click" Padding="0" Margin="4,0,0,0" ToolTip="Sao chép bản dịch"/>
                    </Grid>
                </Border>
 
                <!-- Footer and Operations -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active Model Info -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#EAB308" Margin="0,0,6,0"/>
                        <TextBlock x:Name="LblStatus" 
                                   Text="Gemini (gemini-2.5-flash)" 
                                   Foreground="#475569" 
                                   FontSize="10" 
                                   FontFamily="Consolas"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Actions Panel -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnRetry" Style="{StaticResource ModernButton}" Click="BtnRetry_Click" Margin="0,0,6,0" Content="🔄 Retry" Padding="10,5" Visibility="Collapsed"/>
                        <Button x:Name="BtnSettings" Style="{StaticResource ModernButton}" Click="BtnSettings_Click" Margin="0,0,6,0" Content="⚙️ Setup" Padding="10,5"/>
                        <Button x:Name="BtnClose" Style="{StaticResource ModernButton}" Click="BtnClose_Click" Content="✕ Close" Padding="10,5"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
