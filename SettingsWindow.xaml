<Window x:Class="AITranslator.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AITranslator"
        mc:Ignorable="d"
        Title="Cài đặt AI Translator" 
        Icon="app_icon.ico"
        Height="635" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        Foreground="#E2E8F0"
        WindowStyle="None"
        AllowsTransparency="True">
    
    <Window.Resources>
        <!-- Modern Rounded Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#252536"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold, Inter"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#1E1E2A"/>
                                <Setter Property="Foreground" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Accent Button Style (Save) -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" Padding="{TemplateBinding Padding}" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A26"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#2A2A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI, Inter"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" 
                                          HorizontalScrollBarVisibility="Hidden" 
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="border" Property="Background" Value="#222232"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ComboBox ToggleButton Style -->
        <Style x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="#1E1E2C" BorderBrush="#2A2A3C" BorderThickness="1" CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Arrow -->
                                <Path x:Name="arrow" Grid.Column="1" Fill="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,0" Data="M 0 0 L 3.5 4 L 7 0 Z"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="arrow" Property="Fill" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E2C"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#2A2A3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Toggle Button that covers the entire ComboBox area -->
                            <ToggleButton Grid.ColumnSpan="2" Style="{StaticResource ComboBoxToggleButton}" Focusable="false" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            
                            <!-- Content Area -->
                            <ContentPresenter x:Name="contentPresenter" Grid.Column="0" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="false"/>
                            
                            <!-- Editable TextBox -->
                            <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                     Background="Transparent" 
                                     Foreground="#F8FAFC" 
                                     BorderThickness="0" 
                                     Padding="10,6"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Left"
                                     CaretBrush="#FFFFFF"
                                     Focusable="true"
                                     Visibility="Collapsed">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" 
                                                      HorizontalScrollBarVisibility="Hidden" 
                                                      VerticalScrollBarVisibility="Hidden"
                                                      VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            
                            <!-- Popup -->
                            <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" AllowsTransparency="true" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Bottom" PopupAnimation="Slide">
                                <Border x:Name="dropDownBorder" Background="#14141E" BorderBrush="#2A2A3C" BorderThickness="1" CornerRadius="6" Margin="0,2,0,0" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer x:Name="DropDownScrollViewer" CanContentScroll="true" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="true">
                                <Setter Property="IsTabStop" Value="false"/>
                                <Setter TargetName="contentPresenter" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="PART_Popup" Property="IsEnabled" Value="false"/>
                            </Trigger>
                            <Trigger Property="IsGrouping" Value="true">
                                <Setter Property="ScrollViewer.CanContentScroll" Value="false"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4" Margin="2,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A2A3E"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontFamily" Value="Segoe UI, Inter"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Custom Check Box Visual -->
                            <Border x:Name="checkBoxBorder" 
                                    Grid.Column="0"
                                    Width="16" Height="16" 
                                    Margin="0,0,10,0"
                                    Background="#1A1A26" 
                                    BorderBrush="#2A2A3C" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    VerticalAlignment="Center">
                                <Path x:Name="optionMark" 
                                      Data="M 3 8 L 6 11 L 13 4" 
                                      Stroke="#FFFFFF" 
                                      StrokeThickness="2" 
                                      StrokeStartLineCap="Round" 
                                      StrokeEndLineCap="Round" 
                                      StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            
                            <!-- Content -->
                            <ContentPresenter Grid.Column="1" 
                                              Focusable="False" 
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              Margin="{TemplateBinding Padding}" 
                                              RecognizesAccessKey="True" 
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#222232"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter TargetName="optionMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="checkBoxBorder" Property="Background" Value="#1E1E2A"/>
                                <Setter TargetName="checkBoxBorder" Property="BorderBrush" Value="#242434"/>
                                <Setter Property="Foreground" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" BorderThickness="1" BorderBrush="#2A2A3C" Background="#14141E" Margin="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="20,18,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Header -->
                <RowDefinition Height="*"/>    <!-- Main content (No Scroll) -->
                <RowDefinition Height="Auto"/> <!-- Action Footer -->
            </Grid.RowDefinitions>

            <!-- Title Header -->
            <StackPanel Grid.Row="0" Margin="0,4,0,18">
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Logo Image -->
                    <Border CornerRadius="8" Background="#1B1B26" Padding="4" Width="36" Height="36" Margin="0,0,16,0" BorderThickness="1" BorderBrush="#242434" VerticalAlignment="Center">
                        <Image Source="app_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="LblSettingsTitle" Text="CÀI ĐẶT AI TRANSLATOR" FontSize="14.5" FontWeight="Bold" Foreground="#3B82F6" FontFamily="Segoe UI Semibold"/>
                        <TextBlock x:Name="LblSettingsSubtitle" Text="Cấu hình API Key, mô hình dịch thuật và tùy chỉnh hoạt động" FontSize="10.5" Foreground="#64748B" Margin="0,2,0,0" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Grid>
                <Border Height="1" Background="#242434"/>
            </StackPanel>

            <!-- Main content (No Scroll) -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <!-- AI Provider Section -->
                <Border CornerRadius="8" Background="#1B1B26" Padding="12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#242434">
                    <StackPanel>
                        <TextBlock x:Name="LblAiProvider" Text="Nhà cung cấp dịch AI" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#94A3B8" FontFamily="Segoe UI Semibold"/>
                        <ComboBox x:Name="CboProvider" SelectionChanged="CboProvider_SelectionChanged">
                            <ComboBoxItem Content="Gemini (Google)"/>
                            <ComboBoxItem Content="OpenAI (ChatGPT)"/>
                            <ComboBoxItem Content="Claude (Anthropic)"/>
                            <ComboBoxItem Content="Groq"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Gemini Options -->
                <StackPanel x:Name="SecGemini" Visibility="Visible">
                    <Border CornerRadius="8" Background="#1B1B26" Padding="12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#242434">
                        <StackPanel>
                            <TextBlock x:Name="LblGeminiTitle" Text="Cấu hình Gemini" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#94A3B8" FontFamily="Segoe UI Semibold"/>
                            
                            <TextBlock FontSize="10.5" Margin="0,0,0,5" Foreground="#64748B" FontFamily="Segoe UI">
                                <Run x:Name="RunGeminiKeyLabel" Text="Gemini API Key — "/><Hyperlink x:Name="LinkGeminiKey" NavigateUri="https://aistudio.google.com/app/apikey" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#3B82F6" TextDecorations="None">Lấy API key</Hyperlink>
                            </TextBlock>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtGeminiKey" Grid.Column="0" Text=""/>
                                <Button x:Name="BtnToggleGemini" Content="👁️" Grid.Column="1" Width="36" Margin="6,0,0,0" Click="BtnToggleKey_Click" Padding="0,5"/>
                            </Grid>

                            <TextBlock x:Name="LblGeminiModel" Text="Model Gemini" FontSize="10.5" Margin="0,0,0,5" Foreground="#64748B" FontFamily="Segoe UI"/>
                             <ComboBox x:Name="CboGeminiModel" IsEditable="True">
                                <ComboBoxItem Content="Gemini 2.5 Flash" Tag="gemini-2.5-flash"/>
                                <ComboBoxItem Content="Gemini 2.5 Pro" Tag="gemini-2.5-pro"/>
                                <ComboBoxItem Content="Gemini 2 Flash" Tag="gemini-2.0-flash"/>
                                <ComboBoxItem Content="Gemini 2 Flash Lite" Tag="gemini-2.0-flash-lite"/>
                                <ComboBoxItem Content="Gemini 3.5 Flash" Tag="gemini-3.5-flash"/>
                                <ComboBoxItem Content="Gemini 3.1 Flash Lite" Tag="gemini-3.1-flash-lite"/>
                                <ComboBoxItem Content="Gemini 3.1 Pro" Tag="gemini-3.1-pro"/>
                                <ComboBoxItem Content="Gemini 2.5 Flash Lite" Tag="gemini-2.5-flash-lite"/>
                                <ComboBoxItem Content="Gemini 3 Flash" Tag="gemini-3.0-flash"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- OpenAI Options -->
                <StackPanel x:Name="SecOpenAI" Visibility="Collapsed">
                    <Border CornerRadius="8" Background="#1B1B26" Padding="12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#242434">
                        <StackPanel>
                            <TextBlock x:Name="LblOpenAITitle" Text="Cấu hình OpenAI" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#94A3B8" FontFamily="Segoe UI Semibold"/>
                            
                            <TextBlock FontSize="10.5" Margin="0,0,0,5" Foreground="#64748B" FontFamily="Segoe UI">
                                <Run x:Name="RunOpenAIKeyLabel" Text="OpenAI API Key — "/><Hyperlink x:Name="LinkOpenAIKey" NavigateUri="https://platform.openai.com/api-keys" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#3B82F6" TextDecorations="None">Lấy API key</Hyperlink>
                            </TextBlock>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtOpenAIKey" Grid.Column="0"/>
                                <Button x:Name="BtnToggleOpenAI" Content="👁️" Grid.Column="1" Width="36" Margin="6,0,0,0" Click="BtnToggleKey_Click" Padding="0,5"/>
                            </Grid>

                            <TextBlock x:Name="LblOpenAIModel" Text="Model OpenAI" FontSize="10.5" Margin="0,0,0,5" Foreground="#64748B" FontFamily="Segoe UI"/>
                             <ComboBox x:Name="CboOpenAIModel" IsEditable="True">
                                <ComboBoxItem Content="GPT-5.5 Flagship" Tag="gpt-5.5"/>
                                <ComboBoxItem Content="GPT-5.5 Pro" Tag="gpt-5.5-pro"/>
                                <ComboBoxItem Content="GPT-5.4 Standard" Tag="gpt-5.4"/>
                                <ComboBoxItem Content="GPT-5.4 Mini" Tag="gpt-5.4-mini"/>
                                <ComboBoxItem Content="GPT-4o (Legacy)" Tag="gpt-4o"/>
                                <ComboBoxItem Content="GPT-4o Mini (Legacy)" Tag="gpt-4o-mini"/>
                                <ComboBoxItem Content="GPT-4 Turbo (Legacy)" Tag="gpt-4-turbo"/>
                                <ComboBoxItem Content="GPT-3.5 Turbo (Legacy)" Tag="gpt-3.5-turbo"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Claude Options -->
                <StackPanel x:Name="SecClaude" Visibility="Collapsed">
                    <Border CornerRadius="8" Background="#1B1B26" Padding="12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#242434">
                        <StackPanel>
                            <TextBlock x:Name="LblClaudeTitle" Text="Cấu hình Claude (Anthropic)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#94A3B8" FontFamily="Segoe UI Semibold"/>
                            
                            <TextBlock FontSize="10.5" Margin="0,0,0,5" Foreground="#64748B" FontFamily="Segoe UI">
                                <Run x:Name="RunClaudeKeyLabel" Text="Claude API Key — "/><Hyperlink x:Name="LinkClaudeKey" NavigateUri="https://console.anthropic.com/settings/keys" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#3B82F6" TextDecorations="None">Lấy API key</Hyperlink>
                            </TextBlock>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtClaudeKey" Grid.Column="0"/>
                                <Button x:Name="BtnToggleClaude" Content="👁️" Grid.Column="1" Width="36" Margin="6,0,0,0" Click="BtnToggleKey_Click" Padding="0,5"/>
                            </Grid>

                            <TextBlock x:Name="LblClaudeModel" Text="Model Claude" FontSize="10.5" Margin="0,0,0,5" Foreground="#64748B" FontFamily="Segoe UI"/>
                             <ComboBox x:Name="CboClaudeModel" IsEditable="True">
                                <ComboBoxItem Content="Claude 4.8 Opus" Tag="claude-opus-4-8"/>
                                <ComboBoxItem Content="Claude 4.7 Opus" Tag="claude-opus-4-7"/>
                                <ComboBoxItem Content="Claude 4.6 Sonnet" Tag="claude-sonnet-4-6"/>
                                <ComboBoxItem Content="Claude 4.5 Haiku" Tag="claude-haiku-4-5"/>
                                <ComboBoxItem Content="Claude 3.5 Sonnet (Legacy)" Tag="claude-3-5-sonnet"/>
                                <ComboBoxItem Content="Claude 3.5 Haiku (Legacy)" Tag="claude-3-5-haiku"/>
                                <ComboBoxItem Content="Claude 3 Opus (Legacy)" Tag="claude-3-opus"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>



                <!-- Groq Options -->
                <StackPanel x:Name="SecGroq" Visibility="Collapsed">
                    <Border CornerRadius="8" Background="#1B1B26" Padding="12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#242434">
                        <StackPanel>
                            <TextBlock x:Name="LblGroqTitle" Text="Cấu hình Groq" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#94A3B8" FontFamily="Segoe UI Semibold"/>

                            <TextBlock FontSize="10.5" Margin="0,0,0,5" Foreground="#64748B" FontFamily="Segoe UI">
                                <Run x:Name="RunGroqKeyLabel" Text="Groq API Key — "/><Hyperlink x:Name="LinkGroqKey" NavigateUri="https://console.groq.com/keys" RequestNavigate="Hyperlink_RequestNavigate" Foreground="#3B82F6" TextDecorations="None">Lấy API key</Hyperlink>
                            </TextBlock>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtGroqKey" Grid.Column="0"/>
                                <Button x:Name="BtnToggleGroq" Content="👁️" Grid.Column="1" Width="36" Margin="6,0,0,0" Click="BtnToggleKey_Click" Padding="0,5"/>
                            </Grid>

                            <TextBlock x:Name="LblGroqModel" Text="Model Groq" FontSize="10.5" Margin="0,0,0,5" Foreground="#64748B" FontFamily="Segoe UI"/>
                             <ComboBox x:Name="CboGroqModel" IsEditable="True">
                                <ComboBoxItem Content="Llama 3.3 70B Versatile" Tag="llama-3.3-70b-versatile"/>
                                <ComboBoxItem Content="Llama 3.1 8B Instant (nhanh nhất)" Tag="llama-3.1-8b-instant"/>
                                <ComboBoxItem Content="GPT OSS 120B" Tag="openai/gpt-oss-120b"/>
                                <ComboBoxItem Content="GPT OSS 20B" Tag="openai/gpt-oss-20b"/>
                                <ComboBoxItem Content="Qwen3 32B" Tag="qwen/qwen3-32b"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Hotkey Recorder Section -->
                <Border CornerRadius="8" Background="#1B1B26" Padding="12" Margin="0,0,0,0" BorderThickness="1" BorderBrush="#242434">
                    <StackPanel>
                        <!-- Translate Hotkey -->
                        <TextBlock x:Name="LblHotkeyTranslate" Text="Phím tắt dịch nhanh (Hotkey)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#94A3B8" FontFamily="Segoe UI Semibold"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="TxtHotkey" Grid.Column="0" IsReadOnly="True" Text="Alt + Q" 
                                     Background="#1A1A26" Foreground="#3B82F6" FontWeight="Bold" FontSize="11.5"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     PreviewKeyDown="TxtHotkey_PreviewKeyDown" Cursor="Hand" CaretBrush="Transparent" Padding="8,5"/>
                            
                            <Button x:Name="BtnClearHotkey" Content="✕ Xóa" Grid.Column="1" Margin="6,0,0,0" Width="60" 
                                    Click="BtnClearHotkey_Click" Padding="0,4"/>
                        </Grid>

                        <!-- Rewrite Hotkey -->
                        <TextBlock x:Name="LblHotkeyRewrite" Text="Phím tắt viết lại câu (Rewrite Hotkey)" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#94A3B8" FontFamily="Segoe UI Semibold"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="TxtRewriteHotkey" Grid.Column="0" IsReadOnly="True" Text="Alt + W" 
                                     Background="#1A1A26" Foreground="#3B82F6" FontWeight="Bold" FontSize="11.5"
                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     PreviewKeyDown="TxtHotkey_PreviewKeyDown" Cursor="Hand" CaretBrush="Transparent" Padding="8,5"/>
                            
                            <Button x:Name="BtnClearRewriteHotkey" Content="✕ Xóa" Grid.Column="1" Margin="6,0,0,0" Width="60" 
                                    Click="BtnClearRewriteHotkey_Click" Padding="0,4"/>
                        </Grid>
                        
                        <TextBlock x:Name="LblHotkeyInstruction" Text="Nhấp chuột vào ô chữ xanh, sau đó nhấn tổ hợp phím mới (Ví dụ: Alt+Q, Alt+W) để thay đổi." 
                                   FontSize="9.5" Foreground="#64748B" TextWrapping="Wrap" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                        
                        <Border Height="1" Background="#242434" Margin="0,10,0,8"/>
                        
                        <CheckBox x:Name="ChkStartWithWindows" Content="Khởi chạy cùng Windows" FontWeight="SemiBold" Foreground="#94A3B8" FontFamily="Segoe UI Semibold"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Action Footer -->
            <Border Grid.Row="2" BorderBrush="#242434" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnTest" Content="🧪 Thử kết nối AI" Grid.Column="0" Click="BtnTest_Click"/>
                    
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BtnSave" Style="{StaticResource AccentButton}" Content="💾 Lưu cài đặt" Margin="0,0,8,0" Click="BtnSave_Click"/>
                        <Button x:Name="BtnCancel" Content="✕ Đóng" Click="BtnCancel_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
